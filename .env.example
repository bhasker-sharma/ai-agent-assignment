# Copy this file to .env and fill it in. Never put real keys in this file.

# LLM used for reviewing cases and drafting
# LLM_PROVIDER: gemini or openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1

# API credentials
GEMINI_API_KEY=
OPENAI_API_KEY=

# Embedding model, used for both indexing and retrieval.
# Run "python -m server.cli index" after changing it.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval. A rule group is a handbook heading such as H4 (all of H4.1, H4.2, ...).
# Pinned groups are sent with every case; the rest are picked by similarity.
PINNED_RULE_GROUPS=H1,H2,H3,H11
RETRIEVED_RULE_GROUPS=4

# Folders, relative to the project root
KNOWLEDGE_DIR=data/knowledge_base
EVIDENCE_DIR=data/evidence
INDEX_DIR=index
MODEL_CACHE_DIR=.model_cache
